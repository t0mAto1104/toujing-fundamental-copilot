# Copy this file to .env.local and fill values locally. Never commit real keys.
OPENAI_API_KEY=

# BYOK wrapping key: 32 cryptographically random bytes encoded as 64 hex chars.
# Configure separately from D1, only after operator confirmation. Never commit.
# Missing/malformed key disables personal-key writes and calls (fail closed).
# BYOK_ENCRYPTION_KEY=

# Optional server overrides. Available model IDs are defined in lib/ai-models.ts.
# OPENAI_MODEL=
# SITE_ADMIN_EMAILS=
